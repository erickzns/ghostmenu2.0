-- MOTOR DE CLIQUES ULTRA RÁPIDO
-- ============================================
local ClickCount = 0
local Holding = false
local ActiveThreads = 0
local LastClickTime = tick()
local ClicksInSecond = 0
local DisplayCPS = 0

local function GetClickButton()
    return Config.ClickType == "left" and 0 or Config.ClickType == "right" and 1 or 2
end

-- Método 1: VirtualInputManager (mais rápido)
local function FastClick_VIM()
    local btn = GetClickButton()
    VirtualInputManager:SendMouseButtonEvent(0, 0, btn, true, nil, 0)
    VirtualInputManager:SendMouseButtonEvent(0, 0, btn, false, nil, 0)
end

-- Método 2: Mouse events diretos
local function FastClick_Mouse()
    local char = Players.LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local mouse = Players.LocalPlayer:GetMouse()
            if mouse.Target then
                -- Click no alvo
                local EV = game:GetService("VirtualInputManager")
                local x, y = mouse.X, mouse.Y
                EV:SendMouseButtonEvent(x, y, 0, true, nil, 0)
                EV:SendMouseButtonEvent(x, y, 0, false, nil, 0)

                -- ClickDetector
                if mouse.Target:FindFirstChild("ClickDetector") then
                    pcall(function() mouse.Target.ClickDetector:Fire() end)
                end

                -- .Click() se disponível
                pcall(function() mouse.Target:Click() end)
            end
        end
    end
end

-- Método 3: Múltiplos cliques instantâneos
local function BurstClick(count)
    local btn = GetClickButton()
    for i = 1, count do
        VirtualInputManager:SendMouseButtonEvent(0, 0, btn, true, nil, 0)
        VirtualInputManager:SendMouseButtonEvent(0, 0, btn, false, nil, 0)
    end
end

-- CLIQUE PRINCIPAL OTIMIZADO
local function DoClick()
    pcall(function()
        local mode = Config.SpeedMode

        if mode == "normal" or mode == "rapido" then
            -- Modo normal: 1-2 cliques por chamada
            FastClick_VIM()

        elseif mode == "ultra" then
            -- Modo ultra: burst de 5 cliques
            BurstClick(Config.ClicksPerFrame)

        elseif mode == "turbo" then
            -- Modo turbo: burst de 10 + mouse
            BurstClick(Config.ClicksPerFrame)
            task.spawn(FastClick_Mouse)

        elseif mode == "louco" then
            -- Modo louco: máximo possível
            BurstClick(Config.ClicksPerFrame)
            task.spawn(FastClick_Mouse)
            task.spawn(function()
                BurstClick(math.floor(Config.ClicksPerFrame / 2))
            end)
        end
    end)

    ClickCount = ClickCount + 1
    ClicksInSecond = ClicksInSecond + 1
end

-- Atualizar CPS display
task.spawn(function()
    while true do
        DisplayCPS = ClicksInSecond
        ClicksInSecond = 0

        local display = "Cliques: " .. tostring(ClickCount) .. " | " .. tostring(DisplayCPS) .. " CPS"
        pcall(function()
            ClicksLabel.Text = display
            MiniCPS.Text = tostring(DisplayCPS) .. " CPS"
        end)

        task.wait(1)
    end
end)

-- LOOP PRINCIPAL (thread única base)
task.spawn(function()
    while true do
        if Config.AutoClick and (not Config.HoldMode or Holding) then
            DoClick()
            task.wait(Config.Interval)
        else
            task.wait(0.1)
        end
    end
end)

-- THREADS EXTRAS (modo turbo/louco)
task.spawn(function()
    while true do
        if Config.AutoClick and Config.MultiThread and (Config.SpeedMode == "turbo" or Config.SpeedMode == "louco") then
            for i = 1, Config.ThreadCount do
                task.spawn(function()
                    if Config.AutoClick then
                        DoClick()
                    end
                end)
            end
            task.wait(Config.Interval * 0.5)
        else
            task.wait(0.1)
        end
    end
end)

-- TOGGLE
local function ToggleClicker()
    Config.AutoClick = not Config.AutoClick

    if Config.AutoClick then
        StatusLabel.Text = "LIGADO - " .. Config.SpeedMode:upper()
        StatusLabel.TextColor3 = Color3.fromRGB(85, 255, 85)
        ToggleButton.Text = "■ PARAR (F6)"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(85, 255, 85)
        MiniStatus.Text = "ON"
        MiniStatus.TextColor3 = Color3.fromRGB(85, 255, 85)
        MiniToggle.Text = "■"
    else
        StatusLabel.Text = "DESLIGADO"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        ToggleButton.Text = "▶ LIGAR (F6)"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        MiniStatus.Text = "OFF"
        MiniStatus.TextColor3 = Color3.fromRGB(255, 85, 85)
        MiniToggle.Text = "▶"
    end
end

-- INPUT
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode[Config.ToggleKey] then
        ToggleClicker()
    end
    if Config.HoldMode and input.UserInputType == Enum.UserInputType.MouseButton1 then
        Holding = true
        if not Config.AutoClick then ToggleClicker() end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if Config.HoldMode and input.UserInputType == Enum.UserInputType.MouseButton1 then
        Holding = false
        if Config.AutoClick then ToggleClicker() end
    end
end)

